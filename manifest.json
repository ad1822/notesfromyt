{
  "manifest_version": 2,
  "auther" : "Ayush",
  "name": "Markdown notes from Youtube",
  "version": "1.2.0",
  "description": "Take notes, screenshots, timestamp from youtube video and save it as a Markdown file, Competible with Obsidian template.",
  "permissions": ["tabs", "scripting", "downloads", "storage", "activeTab", "https://www.youtube-transcript.io/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "note-taker@ayush.dev",
      "data_collection_permissions": {
        "required" : ["none"]
      }
    }
  },
  "browser_action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}

