{
  "manifest_version": 2,
  "name": "YouTube Markdown Notes",
  "version": "0.2",
  "description": "Take timestamped Markdown notes with screenshots while watching YouTube.",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "windows"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "src/overlay.js"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png"
    }
  }
}
