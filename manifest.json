{
  "manifest_version": 2,
  "name": "YouTube Markdown Notes",
  "version": "0.1",
  "description": "Take timestamped Markdown notes with screenshots while watching YouTube.",
  "permissions": ["tabs", "scripting", "downloads", "storage", "activeTab", "windows"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png"
    }
  }
}

